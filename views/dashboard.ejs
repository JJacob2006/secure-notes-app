<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - Secure Notes</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <div class="navbar">
    <h2>Secure Notes</h2>
    <div class="nav-links">
      <span>Welcome, <strong><%= username %></strong></span>
      <a href="/auth/logout" class="logout-btn">Logout</a>
    </div>
  </div>

  <div class="container">
    <% if (error) { %>
      <div class="error"><%= error %></div>
    <% } %>

    <div class="notes-header">
      <h3>My Notes</h3>
      <a href="/notes/add" class="add-note-btn">+ Add New Note</a>
    </div>

    <% if (notes && notes.length > 0) { %>
      <div class="notes-grid">
        <% notes.forEach(note => { %>
          <div class="note-card">
            <div class="note-content"><%= note.content %></div>
            <div class="note-date">
              Created: <%= new Date(note.createdAt).toLocaleDateString() %>
            </div>
            <div class="note-actions">
              <form action="/notes/delete/<%= note.id %>" method="POST" style="flex: 1;">
                <button type="submit" class="delete-btn" onclick="return confirm('Are you sure you want to delete this note?');">Delete</button>
              </form>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="empty-state">
        <h3>No notes yet</h3>
        <p>Create your first secure note to get started</p>
        <a href="/notes/add" class="add-note-btn">Create Note</a>
      </div>
    <% } %>
  </div>
</body>
</html>
